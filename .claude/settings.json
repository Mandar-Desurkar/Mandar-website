{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm audit:*)",
      "Bash(npm outdated)",
      "Bash(bash .claude/skills/ship-check/scripts/preflight.sh:*)",
      "Bash(bash .claude/skills/performance-audit/scripts/asset-report.sh:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/update-context.sh\"",
            "timeout": 15,
            "statusMessage": "Checking project context"
          }
        ]
      }
    ]
  }
}
